<?xml version="1.0" encoding="UTF-8"?>
<!--
  Route ALL logging to stderr.

  stdout must be clean JSON-RPC for the MCP stdio protocol.
  This mirrors the Python server's: logging.StreamHandler(sys.stderr)
-->
<configuration>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <!-- target=System.err keeps stdout clean for MCP JSON-RPC -->
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
