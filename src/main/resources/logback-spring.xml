<?xml version="1.0" encoding="UTF-8"?>
<!--
  HTTP transport mode: log to stdout so logs are visible in the terminal / log files.
  (In stdio mode, stdout must stay clean for MCP JSON-RPC — but in HTTP mode that
   constraint no longer applies; the MCP protocol runs over the HTTP socket.)
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %-40logger{40} | %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>

